  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.182.0",
    "typescript": "^5.7.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@9.15.9"
}
