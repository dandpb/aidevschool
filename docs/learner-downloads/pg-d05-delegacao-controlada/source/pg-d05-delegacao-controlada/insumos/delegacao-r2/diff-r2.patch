+"""Testes NOVOS da fatia 2 (validação extraída) — arquivo permitido pelo plano.
+
+Roda sem framework: PYTHONPATH=insumos/fixture python3 insumos/fixture/teste_validacao.py
+"""
+
+from biblioteca import validar_emprestimo
+
+
+def test_validacao_categoria_desconhecida():
+    try:
+        validar_emprestimo("978-85", "rabisco", 0)
+        raise AssertionError("devia ter lancado ValueError")
+    except ValueError as erro:
+        assert "categoria desconhecida: rabisco" in str(erro)
+
+
+def test_validacao_renovacoes_fora_do_limite():
+    try:
+        validar_emprestimo("978-85", "geral", 3)
+        raise AssertionError("devia ter lancado ValueError")
+    except ValueError as erro:
+        assert "renovacoes invalidas: 3" in str(erro)
+
+
+def test_prioridade_categoria_antes_de_isbn_vazio():
+    # C2: dois problemas no mesmo pedido — categoria desconhecida vence.
+    try:
+        validar_emprestimo("", "rabisco", 0)
+        raise AssertionError("devia ter lancado ValueError")
+    except ValueError as erro:
+        assert "categoria desconhecida: rabisco" in str(erro)
+
+
+def test_pedido_valido_passa():
+    validar_emprestimo("978-85", "geral", 2)
+
+
+if __name__ == "__main__":
+    testes = [valor for nome, valor in sorted(globals().items()) if nome.startswith("test_")]
+    for teste in testes:
+        teste()
+        print(f"ok {teste.__name__}")
+    print(f"{len(testes)} testes passaram")
