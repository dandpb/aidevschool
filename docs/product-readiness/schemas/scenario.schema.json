{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "useCaseId", "kind", "execution", "startState", "steps", "assertions", "automation", "sourcePaths"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "useCaseId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "kind": { "enum": ["happy-path", "recovery", "continuity"] },
    "execution": { "enum": ["automated", "observed", "mixed"] },
    "startState": { "type": "string", "minLength": 1 },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "evidence", "claim"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "evidence": { "enum": ["playwright", "observation", "document-review"] },
          "claim": { "type": "string", "minLength": 1 }
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workingDirectory", "argv"],
      "properties": {
        "workingDirectory": { "type": "string", "minLength": 1 },
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sourcePaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
