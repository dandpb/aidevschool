{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "tiers", "severities", "outcomes", "freshness"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": { "type": "integer", "minimum": 1 },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer-ready", "validated-journey", "experimental"],
      "properties": {
        "customer-ready": { "$ref": "#/$defs/tier" },
        "validated-journey": { "$ref": "#/$defs/tier" },
        "experimental": { "$ref": "#/$defs/tier" }
      }
    },
    "severities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low"],
      "properties": {
        "critical": { "$ref": "#/$defs/severity" },
        "high": { "$ref": "#/$defs/severity" },
        "medium": { "$ref": "#/$defs/severity" },
        "low": { "$ref": "#/$defs/severity" }
      }
    },
    "outcomes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["pass", "conditional-follow-up", "downgraded", "blocked", "stale", "unassessed"] }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresExplicitRevalidateBy", "invalidatingChanges"],
      "properties": {
        "requiresExplicitRevalidateBy": { "type": "boolean" },
        "invalidatingChanges": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredScenarioKinds", "requiredEvidenceKinds", "requiredManuals"],
      "properties": {
        "requiredScenarioKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["happy-path", "recovery", "continuity"] }
        },
        "requiredEvidenceKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["playwright", "observation", "document-review"] }
        },
        "requiredManuals": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["student", "facilitator"] }
        }
      }
    },
    "severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treatment"],
      "properties": { "treatment": { "enum": ["block", "disposition-required"] } }
    }
  }
}
