{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product readiness scenario result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "runId",
    "gitSha",
    "executedAt",
    "executor",
    "outcome",
    "sourceFingerprint",
    "manualFingerprint",
    "artifacts",
    "gaps"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "scenarioId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "executedAt": {"type": "string", "format": "date-time"},
    "executor": {"enum": ["automated", "observed", "mixed"]},
    "outcome": {"enum": ["pass", "fail"]},
    "sourceFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manualFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "summary", "owner", "disposition"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "summary": {"type": "string", "minLength": 1},
          "owner": {"type": ["string", "null"]},
          "disposition": {"type": ["string", "null"]}
        }
      }
    }
  }
}
