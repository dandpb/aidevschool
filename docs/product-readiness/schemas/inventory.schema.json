{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "useCases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "useCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surface", "audience", "intendedTier", "promise", "entry", "progressSemantics", "recovery", "nextAction", "scenarioIds", "manualRefs", "sourcePaths", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "surface": { "type": "string", "minLength": 1 },
          "audience": { "type": "string", "minLength": 1 },
          "intendedTier": { "enum": ["customer-ready", "validated-journey", "experimental"] },
          "promise": { "type": "string", "minLength": 1 },
          "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["route", "prerequisites"],
            "properties": {
              "route": { "type": "string", "minLength": 1 },
              "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "progressSemantics": { "enum": ["local-completion", "raw-evidence", "read-only", "exploration"] },
          "recovery": { "type": "string", "minLength": 1 },
          "nextAction": { "type": "string", "minLength": 1 },
          "scenarioIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "manualRefs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["student", "facilitator"],
            "properties": {
              "student": { "type": "string", "pattern": "^[^#]+#[a-z0-9-]+$" },
              "facilitator": { "type": "string", "pattern": "^[^#]+#[a-z0-9-]+$" }
            }
          },
          "sourcePaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
