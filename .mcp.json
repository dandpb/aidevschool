{
  "mcpServers": {
    "mongodb": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-lc",
        "export MDB_MCP_CONNECTION_STRING=\"${MDB_MCP_CONNECTION_STRING:-${MONGODB_MCP_CONNECTION_STRING:-${MONGODB_CONNECTION_STRING:-$MONGODB_URL}}}\"; exec npx -y mongodb-mcp-server@latest"
      ],
      "disabled": true,
      "alwaysAllow": [],
      "directTools": true
    },
    "context7": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-lc",
        "exec npx -y @upstash/context7-mcp --api-key \"$CONTEXT7_API_KEY\""
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "disabled": true,
      "alwaysAllow": [],
      "directTools": true
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-lc",
        "exec npx -y chrome-devtools-mcp@latest"
      ],
      "disabled": false,
      "alwaysAllow": [],
      "directTools": true
    },
    "ai-memory": {
      "type": "http",
      "url": "http://127.0.0.1:49374/mcp",
      "directTools": true,
      "disabledTools": [
        "memory_read_page"
      ]
    }
  }
}
